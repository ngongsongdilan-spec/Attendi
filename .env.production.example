# ------------------------------------------------------------------
# FET Platform - PRODUCTION environment template
# Copy to `.env` on the production host and fill in REAL secrets.
# `python manage.py check` (fet.*) fails loudly on insecure values.
# ------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=False

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=CHANGE_ME_WITH_LONG_RANDOM_STRING

# Public host (nginx domain). Never use "*".
DJANGO_ALLOWED_HOSTS=api.your-domain.com
# Used to validate the Origin header where CSRF is enforced.
CSRF_TRUSTED_ORIGINS=https://api.your-domain.com
# The Vite frontend origin (credentials cookies allowed).
CORS_ALLOWED_ORIGINS=https://app.your-domain.com

# PostgreSQL (psycopg). No SQLite in production.
DATABASE_URL=postgres://fet_app:STRONG_PASSWORD@db:5432/fet_platform?sslmode=disable

# Shared Redis REQUIRED for single-use QR tokens + rate limits across workers.
REDIS_URL=redis://redis:6379/0

# Auth
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=7

# Attendance
ATTENDANCE_TOKEN_TTL_SECONDS=10
ATTENDANCE_SESSION_SECONDS=60
ATTENDANCE_SESSION_MAX_SECONDS=600
ATTENDANCE_MAX_CHECKPOINTS=10

MEDIA_ROOT=/app/media/

# Keep 'Lax'. The SPA and API must share ONE origin (rewrite /api/* in the
# frontend vercel.json) so the JWT cookies stay first-party.
# Do NOT use 'None': cross-site cookies are third-party cookies, which iOS
# Safari (ITP) discards outright -> login returns 200, then bounces to
# /login on iPhone. manage.py check fails with fet.E005 if you set 'None'.
COOKIE_SAMESITE=Lax
COOKIE_SECURE=True

# The browser fetches the SPA from the frontend host and the API from the
# backend host, but cookies are set on the frontend host by the rewrite.
# Leave blank for host-only cookies.
COOKIE_DOMAIN=

# HSTS (keep preload=True only once verified at hstspreload.org)
SECURE_HSTS_SECONDS=31536000